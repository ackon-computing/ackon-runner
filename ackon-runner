def getAckonRunnerTokenAndId(login, password):
    url = "http://coordinator.ackon:8086/login/signin?login=" + login + "&password=" + password
    response = json.loads(requests.get(url).content.decode('ascii'));
    runnerid = response["runnerid"]
    token = response["token"]
    return runnerid, token

def sendAckonRunnerPubkey(runnerid, token, pubkey):
    format = {
        "sendpubkey": {
            "runnerid": runnerid,
            "token": token,
            "pubkey": pubkey,
        }
    }
    resp = requests.post("http://coordinator.ackon:8086/login/pubkey", json=format).content
    #pprint(resp)
    #pprint(resp.decode('ascii'))
    response = json.loads(resp.decode('ascii'))
    if response["status"] == "ok":
        return True
    else:
        return False


