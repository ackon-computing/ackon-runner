def downloadKeys():
    configdir = os.path.expanduser("~/.ackon")
    if not os.path.isdir(configdir):
        os.mkdir(configdir)
    if not os.path.isdir(configdir + "/verify"):
        os.mkdir(configdir + "/verify")
    #download server public keys
    #download coordinator public keys
    url = "http://coordinator.ackon:8086/download/keys/coordinator"
    response = json.loads(requests.get(url).content.decode('ascii'));
#    pprint(response)
    for key in response['coordinators']:
        m = hashlib.sha256()
        m.update(key.encode('ascii'))
        fname = m.hexdigest()
        with open(configdir + "/verify/" + fname + ".pub", "w") as pem:
            pem.write(key)

def login(login,password):
    configdir = os.path.expanduser("~/.ackon")
    if not os.path.isdir(configdir):
        os.mkdir(configdir)
    loginfile = os.path.expanduser("~/.ackon/runner-login")
    if os.path.exists(loginfile):
        print("Already logged in. Please erace ~/.ackon directory before new login")
        return
    runnerid, token = getAckonRunnerTokenAndId(login, password)
#               - "openssl genrsa 3072" - stdout private
# stdin private -  "| openssl rsa -pubout" - stdout public
    private = subprocess.run(["openssl", "genrsa", "3072"], capture_output=True)
    public = subprocess.run(["openssl", "rsa", "-pubout"], input=private.stdout, capture_output=True)
    format = {
        "runnerid": runnerid,
        "token": token,
        "private": private.stdout.decode('ascii'),
        "public": public.stdout.decode('ascii'),
    }
    with open(loginfile, "w") as config:
        if sendAckonRunnerPubkey(runnerid, token, format["public"]):
            config.write(json.dumps(format))
            print("Login successfully")
    sendAckonRunnerPubkey(runnerid, token, public.stdout.decode('ascii'))
    downloadKeys()

def signRsa(raw, private):
    fprivate = os.path.expanduser("~/.ackon/runner-tmp-private.pem")
    fdata = os.path.expanduser("~/.ackon/runner-tmp-file.txt")
    with open(fprivate, "w") as pprivate:
        pprivate.write(private)
    with open(fdata, "w") as pdata:
        pdata.write(raw)
    private = subprocess.run(["openssl", "dgst", "-sha1", "-sign", fprivate, fdata], capture_output=True)
    sign = base64.b64encode(private.stdout).decode('ascii')
    os.remove(fprivate)
    os.remove(fdata)
    return sign


